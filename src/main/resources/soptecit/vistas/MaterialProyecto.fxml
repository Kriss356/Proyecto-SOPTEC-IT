<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ================= MATERIAL POR PROYECTO (relación muchos a muchos proyecto_material con cantidad) ================= -->
<HBox spacing="20.0" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="soptecit.controladores.MaterialProyectoController">
   <children>
      <VBox spacing="12.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <children>
            <Label styleClass="tarjeta-titulo" text="Material asignado a un proyecto" />
            <Label minHeight="-Infinity" styleClass="tarjeta-subtitulo" text="Al guardar, la diferencia se descuenta del almacén (o regresa si quitas material). Si no alcanza, no se guarda nada." wrapText="true" />
            <HBox spacing="8.0">
               <children>
                  <TextField fx:id="txtFiltroProyecto" prefWidth="200.0" promptText="Filtrar proyecto..." />
                  <ComboBox fx:id="cmbProyecto" maxWidth="1.7976931348623157E308" promptText="Proyecto *" HBox.hgrow="ALWAYS" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#refrescar" styleClass="boton-secundario, boton-compacto" text="Refrescar" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <ComboBox fx:id="cmbMaterial" maxWidth="1.7976931348623157E308" promptText="Material del almacén" HBox.hgrow="ALWAYS" />
                  <Spinner fx:id="spnCantidad" editable="true" minWidth="92.0" prefWidth="92.0" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#agregar" styleClass="boton-primario, boton-compacto" text="Agregar" />
               </children>
            </HBox>
            <TableView fx:id="tblMaterialProyecto" minHeight="200.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn prefWidth="260.0" text="Material" />
                  <TableColumn prefWidth="80.0" text="Cantidad" />
                  <TableColumn prefWidth="110.0" text="Precio costo" />
                  <TableColumn prefWidth="110.0" text="Importe" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label fx:id="lblTotalMaterial" maxWidth="1.7976931348623157E308" styleClass="texto-valor" text="Costo del material: \$0.00" HBox.hgrow="ALWAYS" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#quitar" styleClass="boton-peligro, boton-compacto" text="Quitar renglón" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#deshacer" styleClass="boton-secundario, boton-compacto" text="Deshacer" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#guardar" styleClass="boton-exito, boton-compacto" text="Guardar material del proyecto" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
