<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- ================= MATERIAL POR PROVEEDOR (relación muchos a muchos material_proveedor) ================= -->
<HBox spacing="20.0" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="soptecit.controladores.MaterialProveedorController">
   <children>
      <VBox spacing="12.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <children>
            <Label styleClass="tarjeta-titulo" text="¿Qué material surte cada proveedor?" />
            <Label styleClass="tarjeta-subtitulo" text="Sirve para saber a quién comprarle y para armar las órdenes de compra" />
            <HBox spacing="8.0">
               <children>
                  <TextField fx:id="txtFiltroProveedor" prefWidth="200.0" promptText="Filtrar proveedor..." />
                  <ComboBox fx:id="cmbProveedor" maxWidth="1.7976931348623157E308" promptText="Proveedor *" HBox.hgrow="ALWAYS" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#refrescar" styleClass="boton-secundario, boton-compacto" text="Refrescar" />
               </children>
            </HBox>
            <Label fx:id="lblInfoProveedor" styleClass="texto-ayuda" text="Sin proveedor seleccionado" />
            <TableView fx:id="tblSurte" minHeight="220.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colSurteMaterial" prefWidth="260.0" text="Material que surte" />
                  <TableColumn fx:id="colSurtePrecio" prefWidth="110.0" text="Precio costo" />
                  <TableColumn fx:id="colSurteExistencias" prefWidth="100.0" text="Existencias" />
                  <TableColumn fx:id="colSurteOtros" prefWidth="200.0" text="Otros proveedores" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <VBox minWidth="330.0" prefWidth="360.0" spacing="10.0" styleClass="tarjeta">
         <children>
            <Label styleClass="tarjeta-titulo" text="Material del proveedor" />
            <Label minHeight="-Infinity" styleClass="tarjeta-subtitulo" text="Marca todo el material que vende y guarda una sola vez" wrapText="true" />
            <ListView fx:id="lstMateriales" minHeight="220.0" styleClass="lista-casillas" VBox.vgrow="ALWAYS" />
            <Label fx:id="lblMarcados" styleClass="texto-tenue" text="0 materiales marcados" />
            <HBox spacing="8.0">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#deshacer" styleClass="boton-secundario, boton-compacto" text="Deshacer" HBox.hgrow="ALWAYS" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#quitarTodos" styleClass="boton-peligro, boton-compacto" text="Quitar todos" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardar" styleClass="boton-exito" text="Guardar material del proveedor" />
         </children>
      </VBox>
   </children>
</HBox>
