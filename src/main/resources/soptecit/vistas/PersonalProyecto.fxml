<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ================= PERSONAL POR PROYECTO (relación muchos a muchos proyecto_empleado) ================= -->
<HBox spacing="20.0" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="soptecit.controladores.PersonalProyectoController">
   <children>
      <VBox spacing="12.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <children>
            <Label styleClass="tarjeta-titulo" text="Equipo de trabajo por proyecto" />
            <Label styleClass="tarjeta-subtitulo" text="Elige un proyecto para ver y modificar el personal asignado" />
            <HBox spacing="8.0">
               <children>
                  <TextField fx:id="txtFiltroProyecto" prefWidth="220.0" promptText="Filtrar proyecto..." />
                  <ComboBox fx:id="cmbProyecto" maxWidth="1.7976931348623157E308" promptText="Proyecto *" HBox.hgrow="ALWAYS" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#refrescar" styleClass="boton-secundario, boton-compacto" text="Refrescar" />
               </children>
            </HBox>
            <Label fx:id="lblInfoProyecto" styleClass="texto-ayuda" text="Sin proyecto seleccionado" wrapText="true" />
            <TableView fx:id="tblAsignados" minHeight="220.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colAsigNombre" prefWidth="200.0" text="Empleado asignado" />
                  <TableColumn fx:id="colAsigPuesto" prefWidth="160.0" text="Puesto" />
                  <TableColumn fx:id="colAsigTelefono" prefWidth="120.0" text="Teléfono" />
                  <TableColumn fx:id="colAsigCorreo" prefWidth="180.0" text="Correo" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
      </VBox>
      <VBox minWidth="330.0" prefWidth="360.0" spacing="10.0" styleClass="tarjeta">
         <children>
            <Label styleClass="tarjeta-titulo" text="Asignar personal" />
            <Label minHeight="-Infinity" styleClass="tarjeta-subtitulo" text="Marca a todos los que trabajarán en el proyecto y guarda una sola vez" wrapText="true" />
            <ListView fx:id="lstEmpleados" minHeight="220.0" styleClass="lista-casillas" VBox.vgrow="ALWAYS" />
            <Label fx:id="lblMarcados" styleClass="texto-tenue" text="0 empleados marcados" />
            <HBox spacing="8.0">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#deshacer" styleClass="boton-secundario, boton-compacto" text="Deshacer" HBox.hgrow="ALWAYS" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#quitarTodos" styleClass="boton-peligro, boton-compacto" text="Quitar a todos" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarEquipo" styleClass="boton-exito" text="Guardar equipo del proyecto" />
         </children>
      </VBox>
   </children>
</HBox>
