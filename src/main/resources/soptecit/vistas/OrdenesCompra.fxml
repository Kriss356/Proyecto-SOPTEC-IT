<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- ================= ÓRDENES DE COMPRA: orden + partidas (orden_compra_material) ================= -->
<HBox spacing="20.0" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="soptecit.controladores.OrdenesCompraController">
   <children>
      <VBox spacing="12.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <VBox>
                     <children>
                        <Label styleClass="tarjeta-titulo" text="Órdenes de compra" />
                        <Label styleClass="tarjeta-subtitulo" text="Al recibir una orden, su material entra al almacén" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <TextField fx:id="txtBuscarOrden" onAction="#cargarOrdenes" prefWidth="210.0" promptText="Proveedor, proyecto o estado..." />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#cargarOrdenes" styleClass="boton-primario, boton-compacto" text="Buscar" />
               </children>
            </HBox>
            <TableView fx:id="tblOrdenes" minHeight="200.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colOrdFolio" prefWidth="75.0" text="Orden" />
                  <TableColumn fx:id="colOrdProveedor" prefWidth="140.0" text="Proveedor" />
                  <TableColumn fx:id="colOrdProyecto" prefWidth="130.0" text="Proyecto" />
                  <TableColumn fx:id="colOrdFecha" prefWidth="85.0" text="Fecha" />
                  <TableColumn fx:id="colOrdEntrega" prefWidth="85.0" text="Entrega" />
                  <TableColumn fx:id="colOrdTotal" prefWidth="90.0" text="Total" />
                  <TableColumn fx:id="colOrdEstado" prefWidth="90.0" styleClass="col-estado" text="Estado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label fx:id="lblResumenOrdenes" maxWidth="1.7976931348623157E308" styleClass="texto-tenue" text="0 órdenes" HBox.hgrow="ALWAYS" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#recibirOrden" styleClass="boton-exito, boton-compacto" text="Registrar recepción" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#cancelarOrden" styleClass="boton-naranja, boton-compacto" text="Cancelar" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#eliminarOrden" styleClass="boton-peligro, boton-compacto" text="Eliminar" />
               </children>
            </HBox>
         </children>
      </VBox>

      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" minWidth="380.0" prefWidth="405.0" styleClass="panel-scroll">
         <content>
            <VBox spacing="9.0" styleClass="tarjeta">
               <children>
                  <Label fx:id="lblModoOrden" styleClass="tarjeta-titulo" text="Nueva orden de compra" />
                  <Label minHeight="-Infinity" styleClass="tarjeta-subtitulo" text="La orden y todas sus partidas se guardan juntas" wrapText="true" />
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Proveedor *" />
                        <ComboBox fx:id="cmbProveedorOrden" maxWidth="1.7976931348623157E308" promptText="Seleccionar proveedor" />
                     </children>
                  </VBox>
                  <VBox spacing="4.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Proyecto (opcional, vacío = stock general)" />
                        <ComboBox fx:id="cmbProyectoOrden" maxWidth="1.7976931348623157E308" promptText="Stock general" />
                     </children>
                  </VBox>
                  <HBox spacing="10.0">
                     <children>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Fecha de la orden *" />
                              <DatePicker fx:id="dpFechaOrden" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label styleClass="etiqueta-campo" text="Entrega estimada" />
                              <DatePicker fx:id="dpEntregaOrden" maxWidth="1.7976931348623157E308" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <Separator styleClass="separador" />
                  <Label styleClass="seccion-titulo" text="PARTIDAS (MATERIAL A COMPRAR)" />
                  <Label fx:id="lblAyudaProveedor" minHeight="-Infinity" styleClass="texto-ayuda" text="Al elegir proveedor se listan primero los materiales que surte." wrapText="true" />
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <ComboBox fx:id="cmbMaterialOrden" maxWidth="1.7976931348623157E308" promptText="Material" HBox.hgrow="ALWAYS" />
                        <Spinner fx:id="spnCantidadOrden" editable="true" minWidth="92.0" prefWidth="92.0" />
                        <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#agregarPartida" styleClass="boton-primario, boton-compacto" text="+" />
                     </children>
                  </HBox>
                  <TableView fx:id="tblPartidas" minHeight="110.0" prefHeight="150.0">
                     <columns>
                        <TableColumn prefWidth="150.0" text="Material" />
                        <TableColumn prefWidth="45.0" text="Cant." />
                        <TableColumn prefWidth="80.0" text="Precio" />
                        <TableColumn prefWidth="85.0" text="Importe" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
                  <HBox alignment="CENTER_LEFT" spacing="8.0">
                     <children>
                        <Label fx:id="lblTotalOrden" maxWidth="1.7976931348623157E308" styleClass="texto-valor" text="Total: \$0.00" HBox.hgrow="ALWAYS" />
                        <Button minWidth="72.0" mnemonicParsing="false" onAction="#quitarPartida" styleClass="boton-peligro, boton-compacto" text="Quitar" />
                     </children>
                  </HBox>
                  <HBox spacing="8.0">
                     <children>
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpiarOrden" styleClass="boton-secundario, boton-compacto" text="Nueva" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#generarOrden" styleClass="boton-exito, boton-compacto" text="Generar orden" HBox.hgrow="ALWAYS" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#actualizarOrden" styleClass="boton-primario, boton-compacto" text="Actualizar" HBox.hgrow="ALWAYS" />
                     </children>
                  </HBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</HBox>
