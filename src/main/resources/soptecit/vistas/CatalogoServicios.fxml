<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- ================= CATÁLOGO DE SERVICIOS (con imagen) ================= -->
<HBox spacing="20.0" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="soptecit.controladores.CatalogoServiciosController">
   <children>
      <VBox spacing="12.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox>
                     <children>
                        <Label styleClass="tarjeta-titulo" text="Catálogo de servicios" />
                        <Label styleClass="tarjeta-subtitulo" text="Servicios que se agregan a las citas y a las ventas" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <CheckBox fx:id="chkInactivosServ" mnemonicParsing="false" onAction="#cargarServicios" text="Mostrar inactivos" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <TextField fx:id="txtBuscarServ" onAction="#cargarServicios" promptText="Buscar por nombre o descripción..." HBox.hgrow="ALWAYS" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#cargarServicios" styleClass="boton-primario, boton-compacto" text="Buscar" />
                  <TextField fx:id="txtConsultarIdServ" onAction="#consultarPorId" prefWidth="80.0" promptText="ID" />
                  <Button minWidth="-Infinity" mnemonicParsing="false" onAction="#consultarPorId" styleClass="boton-secundario, boton-compacto" text="Mostrar por ID" />
               </children>
            </HBox>
            <TableView fx:id="tblServicios" minHeight="240.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colServId" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="colServNombre" prefWidth="210.0" text="Servicio" />
                  <TableColumn fx:id="colServDesc" prefWidth="220.0" text="Descripción" />
                  <TableColumn fx:id="colServPrecio" prefWidth="95.0" text="Precio" />
                  <TableColumn fx:id="colServEstado" prefWidth="85.0" styleClass="col-estado" text="Registro" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <Label fx:id="lblConteoServ" styleClass="texto-tenue" text="0 servicios" />
         </children>
      </VBox>

      <VBox minWidth="355.0" prefWidth="380.0" spacing="10.0" styleClass="tarjeta">
         <children>
            <Label fx:id="lblModoServicio" styleClass="tarjeta-titulo" text="Registrar servicio" />
            <Label styleClass="tarjeta-subtitulo" text="Nombre, precio e imagen del servicio" />
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Nombre del servicio *" />
                  <TextField fx:id="txtNombreServ" promptText="Ej. Instalación de nodo de red Cat6" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Precio (sin IVA) *" />
                  <TextField fx:id="txtPrecioServ" promptText="\$ 0.00" />
               </children>
            </VBox>
            <VBox spacing="4.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Descripción" />
                  <TextArea fx:id="txtDescServ" prefHeight="70.0" prefRowCount="3" promptText="Qué incluye el servicio..." wrapText="true" />
               </children>
            </VBox>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                  <StackPane prefHeight="80.0" prefWidth="80.0" styleClass="imagen-preview">
                     <children>
                        <ImageView fx:id="imgServicio" fitHeight="72.0" fitWidth="72.0" preserveRatio="true" />
                     </children>
                  </StackPane>
                  <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Imagen del servicio" />
                        <Label fx:id="lblRutaImgServ" styleClass="texto-tenue" text="Sin imagen seleccionada" wrapText="true" />
                        <HBox spacing="8.0">
                           <children>
                              <Button mnemonicParsing="false" onAction="#seleccionarImagen" styleClass="boton-secundario, boton-compacto" text="Elegir imagen" />
                              <Button mnemonicParsing="false" onAction="#quitarImagen" styleClass="boton-secundario, boton-compacto" text="Quitar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </children>
            </HBox>
            <Region VBox.vgrow="ALWAYS" />
            <HBox spacing="8.0">
               <children>
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpiar" styleClass="boton-secundario, boton-compacto" text="Nuevo" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnGuardarServicio" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardar" styleClass="boton-exito, boton-compacto" text="Guardar" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnActualizarServicio" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#actualizar" styleClass="boton-primario, boton-compacto" text="Actualizar" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox spacing="8.0">
               <children>
                  <Button fx:id="btnDesactivarServicio" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#desactivar" styleClass="boton-naranja, boton-compacto" text="Desactivar" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnReactivarServicio" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#reactivar" styleClass="boton-secundario, boton-compacto" text="Reactivar" HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnEliminarServicio" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eliminar" styleClass="boton-peligro, boton-compacto" text="Eliminar" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
