<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.SVGPath?>

<!-- ================= SOLICITUDES DE CLIENTES (lo que llega desde el Portal del cliente) ================= -->
<VBox prefHeight="760.0" prefWidth="1072.0" spacing="18.0" styleClass="modulo" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="soptecit.controladores.SolicitudesClientesController">
   <children>

      <!-- KPIs -->
      <HBox spacing="18.0">
         <children>
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="14.0" HBox.hgrow="ALWAYS">
               <styleClass>
                  <String fx:value="kpi" />
                  <String fx:value="kpi-azul" />
               </styleClass>
               <children>
                  <StackPane>
                     <children>
                        <Rectangle height="46.0" styleClass="kpi-icono-fondo" width="46.0" />
                        <SVGPath content="M4 6 H20 V20.5 H4 Z M4 10 H20 M8.5 3.5 V7.5 M15.5 3.5 V7.5" styleClass="kpi-icono" />
                     </children>
                  </StackPane>
                  <VBox>
                     <children>
                        <Label fx:id="lblCitasPendientes" styleClass="kpi-valor" text="0" />
                        <Label styleClass="kpi-etiqueta" text="Citas por confirmar" />
                        <Label styleClass="kpi-tendencia-ok" text="Pedidas desde el Portal del cliente" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="14.0" HBox.hgrow="ALWAYS">
               <styleClass>
                  <String fx:value="kpi" />
                  <String fx:value="kpi-naranja" />
               </styleClass>
               <children>
                  <StackPane>
                     <children>
                        <Rectangle height="46.0" styleClass="kpi-icono-fondo" width="46.0" />
                        <SVGPath content="M3.5 7.5 L12 3.5 L20.5 7.5 V16.5 L12 20.5 L3.5 16.5 Z M3.5 7.5 L12 11.5 L20.5 7.5 M12 11.5 V20.5" styleClass="kpi-icono" />
                     </children>
                  </StackPane>
                  <VBox>
                     <children>
                        <Label fx:id="lblPedidosPendientes" styleClass="kpi-valor" text="0" />
                        <Label styleClass="kpi-etiqueta" text="Pedidos por preparar" />
                        <Label fx:id="lblPedidosListos" styleClass="kpi-tendencia-ok" text="0 listos para recoger" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="14.0" HBox.hgrow="ALWAYS">
               <styleClass>
                  <String fx:value="kpi" />
                  <String fx:value="kpi-verde" />
               </styleClass>
               <children>
                  <StackPane>
                     <children>
                        <Rectangle height="46.0" styleClass="kpi-icono-fondo" width="46.0" />
                        <SVGPath content="M12 2.5 V21.5 M16.5 6.5 H10 A3 3 0 0 0 10 12.5 H14 A3 3 0 0 1 14 18.5 H7" styleClass="kpi-icono" />
                     </children>
                  </StackPane>
                  <VBox>
                     <children>
                        <Label fx:id="lblMontoApartado" styleClass="kpi-valor" text="\$0.00" />
                        <Label styleClass="kpi-etiqueta" text="Por cobrar en pedidos" />
                        <Label styleClass="kpi-tendencia-ok" text="Se paga al recoger" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </HBox>

      <!-- Citas solicitadas -->
      <VBox spacing="12.0" styleClass="tarjeta" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox>
                     <children>
                        <Label styleClass="tarjeta-titulo" text="Citas e instalaciones solicitadas" />
                        <Label styleClass="tarjeta-subtitulo" text="Llama al cliente para confirmar y marca la cita como confirmada o recházala" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button mnemonicParsing="false" onAction="#refrescar" text="Refrescar">
                     <styleClass>
                        <String fx:value="boton-secundario" />
                        <String fx:value="boton-compacto" />
                     </styleClass>
                  </Button>
               </children>
            </HBox>
            <TableView fx:id="tblCitas" minHeight="200.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colCitaId" maxWidth="60.0" prefWidth="50.0" text="ID" />
                  <TableColumn fx:id="colCitaFecha" maxWidth="110.0" prefWidth="95.0" text="Fecha" />
                  <TableColumn fx:id="colCitaHora" maxWidth="80.0" prefWidth="70.0" text="Hora" />
                  <TableColumn fx:id="colCitaCliente" prefWidth="170.0" text="Cliente" />
                  <TableColumn fx:id="colCitaServicio" prefWidth="140.0" text="Servicio" />
                  <TableColumn fx:id="colCitaDetalle" prefWidth="330.0" text="Teléfono, domicilio y nota" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label fx:id="lblConteoCitas" styleClass="texto-tenue" text="0 citas por confirmar" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnRechazarCita" mnemonicParsing="false" onAction="#rechazarCita" text="Rechazar">
                     <styleClass>
                        <String fx:value="boton-peligro" />
                        <String fx:value="boton-compacto" />
                     </styleClass>
                     <tooltip>
                        <Tooltip text="Marca la cita como Cancelada (el horario queda libre)" />
                     </tooltip>
                  </Button>
                  <Button fx:id="btnConfirmarCita" mnemonicParsing="false" onAction="#confirmarCita" text="Confirmar cita">
                     <styleClass>
                        <String fx:value="boton-exito" />
                        <String fx:value="boton-compacto" />
                     </styleClass>
                     <tooltip>
                        <Tooltip text="Marca la cita como Confirmada; el cliente lo verá en su portal" />
                     </tooltip>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- Pedidos de la tienda -->
      <VBox spacing="12.0" styleClass="tarjeta" VBox.vgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <VBox>
                     <children>
                        <Label styleClass="tarjeta-titulo" text="Pedidos de la tienda" />
                        <Label styleClass="tarjeta-subtitulo" text="Material que apartaron los clientes (ya se descontó del almacén)" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <CheckBox fx:id="chkTodosPedidos" mnemonicParsing="false" onAction="#refrescar" text="Ver también entregados y cancelados" />
               </children>
            </HBox>
            <TableView fx:id="tblPedidos" minHeight="200.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn fx:id="colPedFolio" maxWidth="80.0" prefWidth="70.0" text="Folio" />
                  <TableColumn fx:id="colPedFecha" maxWidth="140.0" prefWidth="120.0" text="Fecha" />
                  <TableColumn fx:id="colPedCliente" prefWidth="160.0" text="Cliente" />
                  <TableColumn fx:id="colPedProductos" prefWidth="300.0" text="Productos" />
                  <TableColumn fx:id="colPedTotal" maxWidth="110.0" prefWidth="90.0" text="Total" />
                  <TableColumn fx:id="colPedEstado" maxWidth="160.0" prefWidth="130.0" styleClass="col-estado" text="Estado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <Label fx:id="lblConteoPedidos" styleClass="texto-tenue" text="0 pedidos" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnCancelarPedido" mnemonicParsing="false" onAction="#cancelarPedido" text="Cancelar pedido">
                     <styleClass>
                        <String fx:value="boton-peligro" />
                        <String fx:value="boton-compacto" />
                     </styleClass>
                     <tooltip>
                        <Tooltip text="Cancela el pedido y regresa las piezas al almacén" />
                     </tooltip>
                  </Button>
                  <Button fx:id="btnPedidoListo" mnemonicParsing="false" onAction="#marcarListo" text="Listo para recoger">
                     <styleClass>
                        <String fx:value="boton-primario" />
                        <String fx:value="boton-compacto" />
                     </styleClass>
                  </Button>
                  <Button fx:id="btnPedidoEntregado" mnemonicParsing="false" onAction="#marcarEntregado" text="Entregado y pagado">
                     <styleClass>
                        <String fx:value="boton-exito" />
                        <String fx:value="boton-compacto" />
                     </styleClass>
                  </Button>
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</VBox>
