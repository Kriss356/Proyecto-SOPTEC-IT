<!-- ================= COMPRAS-ALMACÉN: material, movimientos, órdenes y proveedores ================= -->
<VBox prefHeight="760.0" prefWidth="1072.0" spacing="20.0" styleClass="modulo" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="soptecit.controladores.ComprasAlmacenController">
   <fx:define>
      <ToggleGroup fx:id="grupoMovimiento" />
   </fx:define>
   <children>

      <!-- Indicadores de material -->
      <HBox spacing="18.0">
         <children>
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="14.0" HBox.hgrow="ALWAYS">
               <styleClass>
                  <String fx:value="kpi" />
                  <String fx:value="kpi-azul" />
               </styleClass>
               <children>
                  <StackPane>
                     <children>
                        <Rectangle height="42.0" styleClass="kpi-icono-fondo" width="42.0" />
                        <SVGPath content="M3.5 7.5 L12 3.5 L20.5 7.5 V16.5 L12 20.5 L3.5 16.5 Z M3.5 7.5 L12 11.5 L20.5 7.5 M12 11.5 V20.5" styleClass="kpi-icono" />
                     </children>
                  </StackPane>
                  <VBox>
                     <children>
                        <Label fx:id="lblTotalMateriales" styleClass="kpi-valor" text="148" />
                        <Label styleClass="kpi-etiqueta" text="Materiales registrados" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="14.0" HBox.hgrow="ALWAYS">
               <styleClass>
                  <String fx:value="kpi" />
                  <String fx:value="kpi-rojo" />
               </styleClass>
               <children>
                  <StackPane>
                     <children>
                        <Rectangle height="42.0" styleClass="kpi-icono-fondo" width="42.0" />
                        <SVGPath content="M12 4 L21 19.5 H3 Z M12 10 V14 M12 16.8 V17" styleClass="kpi-icono" />
                     </children>
                  </StackPane>
                  <VBox>
                     <children>
                        <Label fx:id="lblBajoStockAlm" styleClass="kpi-valor" text="7" />
                        <Label styleClass="kpi-etiqueta" text="Bajo stock mínimo" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="14.0" HBox.hgrow="ALWAYS">
               <styleClass>
                  <String fx:value="kpi" />
                  <String fx:value="kpi-naranja" />
               </styleClass>
               <children>
                  <StackPane>
                     <children>
                        <Rectangle height="42.0" styleClass="kpi-icono-fondo" width="42.0" />
                        <SVGPath content="M6 3 H14 L19 8 V21 H6 Z M14 3 V8 H19 M9 13 H16 M9 17 H14" styleClass="kpi-icono" />
                     </children>
                  </StackPane>
                  <VBox>
                     <children>
                        <Label fx:id="lblOrdenesPendientes" styleClass="kpi-valor" text="4" />
                        <Label styleClass="kpi-etiqueta" text="Órdenes por recibir" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="14.0" HBox.hgrow="ALWAYS">
               <styleClass>
                  <String fx:value="kpi" />
                  <String fx:value="kpi-verde" />
               </styleClass>
               <children>
                  <StackPane>
                     <children>
                        <Rectangle height="42.0" styleClass="kpi-icono-fondo" width="42.0" />
                        <SVGPath content="M12 3 V21 M16.5 7 H10 A2.5 2.5 0 0 0 10 12 H14 A2.5 2.5 0 0 1 14 17 H7" styleClass="kpi-icono" />
                     </children>
                  </StackPane>
                  <VBox>
                     <children>
                        <Label fx:id="lblValorInventario" styleClass="kpi-valor" text="\$312,750" />
                        <Label styleClass="kpi-etiqueta" text="Valor del material" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </HBox>

      <TabPane fx:id="tabsCompras" minHeight="460.0" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
         <tabs>

            <!-- ========================= MATERIAL ========================= -->
            <Tab text="Material">
               <content>
                  <VBox spacing="12.0" styleClass="tarjeta">
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <TextField fx:id="txtBuscarMaterial" promptText="Buscar por clave o nombre de material..." HBox.hgrow="ALWAYS" />
                              <ComboBox fx:id="cmbCategoriaFiltro" prefWidth="170.0" promptText="Categoría">
                                 <items>
                                    <FXCollections fx:factory="observableArrayList">
                                       <String fx:value="Todas" />
                                       <String fx:value="Cable UTP" />
                                       <String fx:value="Fibra óptica" />
                                       <String fx:value="Conectores" />
                                       <String fx:value="Canalización" />
                                       <String fx:value="Racks y gabinetes" />
                                       <String fx:value="Herramienta" />
                                    </FXCollections>
                                 </items>
                              </ComboBox>
                              <ComboBox fx:id="cmbEstadoFiltro" prefWidth="140.0" promptText="Existencia">
                                 <items>
                                    <FXCollections fx:factory="observableArrayList">
                                       <String fx:value="Todas" />
                                       <String fx:value="Disponible" />
                                       <String fx:value="Bajo stock" />
                                       <String fx:value="Agotado" />
                                    </FXCollections>
                                 </items>
                              </ComboBox>
                              <Button fx:id="btnSolicitarCompra" mnemonicParsing="false" onAction="#solicitarCompra" styleClass="boton-naranja" text="Solicitar compra" />
                           </children>
                        </HBox>
                        <TableView fx:id="tblInventario" minHeight="200.0" VBox.vgrow="ALWAYS">
                           <columns>
                              <TableColumn prefWidth="80.0" text="Clave" />
                              <TableColumn prefWidth="190.0" text="Material" />
                              <TableColumn prefWidth="110.0" text="Categoría" />
                              <TableColumn prefWidth="95.0" text="Existencia" />
                              <TableColumn prefWidth="70.0" text="Mínimo" />
                              <TableColumn prefWidth="90.0" text="Precio unit." />
                              <TableColumn prefWidth="120.0" text="Proveedor" />
                              <TableColumn prefWidth="95.0" styleClass="col-estado" text="Estado" />
                           </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                        <Separator styleClass="separador" />
                        <Label styleClass="seccion-titulo" text="REGISTRAR MATERIAL NUEVO" />
                        <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                           <children>
                              <VBox prefWidth="100.0" spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Clave" />
                                    <TextField fx:id="txtClaveMaterial" promptText="MAT-000" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Nombre del material" />
                                    <TextField fx:id="txtNombreMaterial" promptText="Ej. Patch cord Cat6 1 m" />
                                 </children>
                              </VBox>
                              <VBox prefWidth="150.0" spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Categoría" />
                                    <ComboBox fx:id="cmbCategoriaMaterial" maxWidth="1.7976931348623157E308" promptText="Seleccionar">
                                       <items>
                                          <FXCollections fx:factory="observableArrayList">
                                             <String fx:value="Cable UTP" />
                                             <String fx:value="Fibra óptica" />
                                             <String fx:value="Conectores" />
                                             <String fx:value="Canalización" />
                                             <String fx:value="Racks y gabinetes" />
                                             <String fx:value="Herramienta" />
                                          </FXCollections>
                                       </items>
                                    </ComboBox>
                                 </children>
                              </VBox>
                              <VBox prefWidth="110.0" spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Unidad" />
                                    <ComboBox fx:id="cmbUnidad" maxWidth="1.7976931348623157E308" promptText="Pieza">
                                       <items>
                                          <FXCollections fx:factory="observableArrayList">
                                             <String fx:value="Pieza" />
                                             <String fx:value="Bobina" />
                                             <String fx:value="Metro" />
                                             <String fx:value="Caja" />
                                             <String fx:value="Rollo" />
                                          </FXCollections>
                                       </items>
                                    </ComboBox>
                                 </children>
                              </VBox>
                              <VBox prefWidth="85.0" spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Mínimo" />
                                    <TextField fx:id="txtMinimo" promptText="0" />
                                 </children>
                              </VBox>
                              <VBox prefWidth="100.0" spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Precio" />
                                    <TextField fx:id="txtPrecioMaterial" promptText="\$ 0.00" />
                                 </children>
                              </VBox>
                              <Button fx:id="btnAgregarMaterial" mnemonicParsing="false" onAction="#agregarMaterial" styleClass="boton-exito" text="Agregar" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </content>
            </Tab>

            <!-- ===================== ENTRADAS Y SALIDAS ===================== -->
            <Tab text="Entradas y salidas">
               <content>
                  <HBox spacing="20.0">
                     <children>
                        <VBox minWidth="330.0" prefWidth="350.0" spacing="10.0" styleClass="tarjeta">
                           <children>
                              <Label styleClass="tarjeta-titulo" text="Registrar movimiento" />
                              <HBox spacing="20.0">
                                 <children>
                                    <RadioButton fx:id="rbEntrada" mnemonicParsing="false" selected="true" text="Entrada (recepción)" toggleGroup="$grupoMovimiento" />
                                    <RadioButton fx:id="rbSalida" mnemonicParsing="false" text="Salida (a proyecto)" toggleGroup="$grupoMovimiento" />
                                 </children>
                                 <VBox.margin>
                                    <Insets bottom="4.0" top="4.0" />
                                 </VBox.margin>
                              </HBox>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Material" />
                                    <ComboBox fx:id="cmbMaterialMov" editable="true" maxWidth="1.7976931348623157E308" promptText="Buscar material" />
                                 </children>
                              </VBox>
                              <HBox spacing="10.0">
                                 <children>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="etiqueta-campo" text="Cantidad" />
                                          <Spinner fx:id="spnCantidadMov" editable="true" maxWidth="1.7976931348623157E308" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="etiqueta-campo" text="Fecha" />
                                          <DatePicker fx:id="dpFechaMov" maxWidth="1.7976931348623157E308" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Orden de compra (entradas)" />
                                    <ComboBox fx:id="cmbOrdenMov" maxWidth="1.7976931348623157E308" promptText="OC-0000" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Proyecto destino (salidas)" />
                                    <ComboBox fx:id="cmbProyectoMov" disable="true" maxWidth="1.7976931348623157E308" promptText="PRY-0000" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Entrega / recibe" />
                                    <ComboBox fx:id="cmbResponsableMov" maxWidth="1.7976931348623157E308" promptText="Responsable" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0" VBox.vgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Observaciones" />
                                    <TextArea fx:id="txtObservacionesMov" minHeight="50.0" prefRowCount="2" wrapText="true" VBox.vgrow="ALWAYS" />
                                 </children>
                              </VBox>
                              <Button fx:id="btnRegistrarMov" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrarMovimiento" styleClass="boton-exito" text="Registrar movimiento" />
                           </children>
                        </VBox>
                        <VBox spacing="14.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox alignment="CENTER_LEFT" spacing="10.0">
                                 <children>
                                    <VBox>
                                       <children>
                                          <Label styleClass="tarjeta-titulo" text="Historial de movimientos" />
                                          <Label styleClass="tarjeta-subtitulo" text="Entradas por compra y salidas a proyectos" />
                                       </children>
                                    </VBox>
                                    <Region HBox.hgrow="ALWAYS" />
                                    <DatePicker fx:id="dpFiltroMov" prefWidth="150.0" promptText="Filtrar fecha" />
                                 </children>
                              </HBox>
                              <TableView fx:id="tblMovimientos" minHeight="240.0" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn prefWidth="80.0" text="Fecha" />
                                    <TableColumn prefWidth="80.0" styleClass="col-estado" text="Tipo" />
                                    <TableColumn prefWidth="160.0" text="Material" />
                                    <TableColumn prefWidth="70.0" text="Cantidad" />
                                    <TableColumn prefWidth="95.0" text="OC / Proyecto" />
                                    <TableColumn prefWidth="100.0" text="Responsable" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </content>
            </Tab>

            <!-- ===================== ÓRDENES DE COMPRA ===================== -->
            <Tab text="Órdenes de compra">
               <content>
                  <HBox spacing="20.0">
                     <children>
                        <VBox spacing="14.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox>
                                 <children>
                                    <Label styleClass="tarjeta-titulo" text="Órdenes recientes" />
                                    <Label styleClass="tarjeta-subtitulo" text="Material solicitado para los proyectos aprobados" />
                                 </children>
                              </VBox>
                              <TableView fx:id="tblOrdenes" minHeight="220.0" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn prefWidth="75.0" text="Orden" />
                                    <TableColumn prefWidth="120.0" text="Proveedor" />
                                    <TableColumn prefWidth="90.0" text="Proyecto" />
                                    <TableColumn prefWidth="85.0" text="Entrega" />
                                    <TableColumn prefWidth="85.0" text="Total" />
                                    <TableColumn prefWidth="95.0" styleClass="col-estado" text="Estado" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                 <children>
                                    <Button mnemonicParsing="false" onAction="#cancelarOrden" styleClass="boton-peligro" text="Cancelar orden" />
                                    <Button fx:id="btnRecibirOrden" mnemonicParsing="false" onAction="#registrarRecepcion" styleClass="boton-primario" text="Registrar recepción" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                        <VBox minWidth="350.0" prefWidth="370.0" spacing="10.0" styleClass="tarjeta">
                           <children>
                              <Label styleClass="tarjeta-titulo" text="Nueva orden de compra" />
                              <HBox spacing="10.0">
                                 <children>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="etiqueta-campo" text="Proveedor" />
                                          <ComboBox fx:id="cmbProveedorOrden" maxWidth="1.7976931348623157E308" promptText="Seleccionar" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="etiqueta-campo" text="Proyecto" />
                                          <ComboBox fx:id="cmbProyectoOrden" maxWidth="1.7976931348623157E308" promptText="Seleccionar" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Fecha de entrega esperada" />
                                    <DatePicker fx:id="dpEntregaOrden" maxWidth="1.7976931348623157E308" />
                                 </children>
                              </VBox>
                              <Label styleClass="seccion-titulo" text="PARTIDAS" />
                              <HBox spacing="6.0">
                                 <children>
                                    <ComboBox fx:id="cmbMaterialOrden" editable="true" maxWidth="1.7976931348623157E308" promptText="Material" HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="txtCantidadOrden" prefWidth="60.0" promptText="Cant." />
                                    <Button mnemonicParsing="false" onAction="#agregarPartida" styleClass="boton-primario">
                                       <graphic>
                                          <SVGPath content="M12 5 V19 M5 12 H19" styleClass="icono-boton" />
                                       </graphic>
                                    </Button>
                                 </children>
                              </HBox>
                              <TableView fx:id="tblPartidas" minHeight="110.0" prefHeight="130.0" VBox.vgrow="ALWAYS">
                                 <columns>
                                    <TableColumn prefWidth="130.0" text="Material" />
                                    <TableColumn prefWidth="50.0" text="Cant." />
                                    <TableColumn prefWidth="70.0" text="Precio" />
                                    <TableColumn prefWidth="75.0" text="Importe" />
                                 </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                              </TableView>
                              <HBox alignment="CENTER_LEFT" styleClass="item-lista">
                                 <children>
                                    <Label styleClass="tarjeta-titulo" text="Total" />
                                    <Region HBox.hgrow="ALWAYS" />
                                    <Label fx:id="lblTotalOrden" styleClass="texto-total" text="\$0.00" />
                                 </children>
                              </HBox>
                              <Button fx:id="btnGenerarOrden" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#generarOrden" styleClass="boton-exito" text="Generar orden de compra" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </content>
            </Tab>

            <!-- ===================== PROVEEDORES Y PRECIOS ===================== -->
            <Tab text="Proveedores y precios">
               <content>
                  <HBox spacing="20.0">
                     <children>
                        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                           <children>
                              <VBox spacing="12.0" styleClass="tarjeta" VBox.vgrow="ALWAYS">
                                 <children>
                                    <Label styleClass="tarjeta-titulo" text="Proveedores" />
                                    <TableView fx:id="tblProveedores" minHeight="130.0" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn prefWidth="140.0" text="Proveedor" />
                                          <TableColumn prefWidth="110.0" text="Contacto" />
                                          <TableColumn prefWidth="100.0" text="Teléfono" />
                                          <TableColumn prefWidth="90.0" text="Entrega" />
                                          <TableColumn prefWidth="100.0" text="Condiciones" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                              <VBox spacing="12.0" styleClass="tarjeta" VBox.vgrow="ALWAYS">
                                 <children>
                                    <HBox alignment="CENTER_LEFT">
                                       <children>
                                          <Label styleClass="tarjeta-titulo" text="Lista de precios" />
                                          <Region HBox.hgrow="ALWAYS" />
                                          <TextField fx:id="txtBuscarPrecio" prefWidth="200.0" promptText="Buscar material..." />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tblPrecios" minHeight="130.0" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn prefWidth="160.0" text="Material" />
                                          <TableColumn prefWidth="120.0" text="Proveedor" />
                                          <TableColumn prefWidth="80.0" text="Precio" />
                                          <TableColumn prefWidth="80.0" text="Entrega" />
                                          <TableColumn prefWidth="90.0" text="Actualizado" />
                                       </columns>
                                       <columnResizePolicy>
                                          <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                       </columnResizePolicy>
                                    </TableView>
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                        <VBox minWidth="320.0" prefWidth="330.0" spacing="10.0" styleClass="tarjeta">
                           <children>
                              <Label styleClass="tarjeta-titulo" text="Registrar proveedor" />
                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Razón social" />
                                    <TextField fx:id="txtNombreProveedor" promptText="Nombre del proveedor" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="RFC" />
                                    <TextField fx:id="txtRfcProveedor" promptText="RFC del proveedor" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0">
                                 <children>
                                    <Label styleClass="etiqueta-campo" text="Contacto" />
                                    <TextField fx:id="txtContactoProveedor" promptText="Nombre del contacto" />
                                 </children>
                              </VBox>
                              <HBox spacing="10.0">
                                 <children>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="etiqueta-campo" text="Teléfono" />
                                          <TextField fx:id="txtTelefonoProveedor" promptText="Teléfono" />
                                       </children>
                                    </VBox>
                                    <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                       <children>
                                          <Label styleClass="etiqueta-campo" text="Entrega (días)" />
