<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.collections.FXCollections?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- ================= CITAS (apartado independiente de Ventas) ================= -->
<HBox prefHeight="700.0" prefWidth="1072.0" spacing="20.0" styleClass="modulo" stylesheets="@../css/estilos.css" xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="soptecit.controladores.CitasController">
   <fx:define>
      <ToggleGroup fx:id="grupoDias" />
   </fx:define>
   <children>

      <!-- ===================== AGENDA ===================== -->
      <VBox spacing="14.0" styleClass="tarjeta" HBox.hgrow="ALWAYS">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
               <children>
                  <VBox>
                     <children>
                        <Label styleClass="tarjeta-titulo" text="Agenda de citas" />
                        <Label fx:id="lblSemana" styleClass="tarjeta-subtitulo" text="Semana del 2 al 8 de noviembre de 2026" />
                     </children>
                  </VBox>
                  <Region HBox.hgrow="ALWAYS" />
                  <DatePicker fx:id="dpFecha" prefWidth="150.0" promptText="Ir a fecha" />
                  <Button fx:id="btnHoy" mnemonicParsing="false" onAction="#irAHoy" styleClass="boton-secundario" text="Hoy" />
               </children>
            </HBox>

            <!-- Días de la semana -->
            <HBox spacing="8.0">
               <children>
                  <ToggleButton maxWidth="1.7976931348623157E308" mnemonicParsing="false" selected="true" styleClass="dia-toggle" text="Lun&#10;2" toggleGroup="$grupoDias" HBox.hgrow="ALWAYS" />
                  <ToggleButton maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="dia-toggle" text="Mar&#10;3" toggleGroup="$grupoDias" HBox.hgrow="ALWAYS" />
                  <ToggleButton maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="dia-toggle" text="Mié&#10;4" toggleGroup="$grupoDias" HBox.hgrow="ALWAYS" />
                  <ToggleButton maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="dia-toggle" text="Jue&#10;5" toggleGroup="$grupoDias" HBox.hgrow="ALWAYS" />
                  <ToggleButton maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="dia-toggle" text="Vie&#10;6" toggleGroup="$grupoDias" HBox.hgrow="ALWAYS" />
                  <ToggleButton maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="dia-toggle" text="Sáb&#10;7" toggleGroup="$grupoDias" HBox.hgrow="ALWAYS" />
                  <ToggleButton maxWidth="1.7976931348623157E308" mnemonicParsing="false" styleClass="dia-toggle" text="Dom&#10;8" toggleGroup="$grupoDias" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <!-- Filtros -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <TextField fx:id="txtBuscarCita" promptText="Buscar por cliente o empresa..." HBox.hgrow="ALWAYS" />
                  <ComboBox fx:id="cmbFiltroServicio" prefWidth="160.0" promptText="Tipo de servicio">
                     <items>
                        <FXCollections fx:factory="observableArrayList">
                           <String fx:value="Todos" />
                           <String fx:value="Asesoría" />
                           <String fx:value="Levantamiento" />
                           <String fx:value="Instalación" />
                           <String fx:value="Mantenimiento" />
                           <String fx:value="Seguimiento" />
                        </FXCollections>
                     </items>
                  </ComboBox>
                  <ComboBox fx:id="cmbFiltroEstado" prefWidth="140.0" promptText="Estado">
                     <items>
                        <FXCollections fx:factory="observableArrayList">
                           <String fx:value="Todas" />
                           <String fx:value="Programada" />
                           <String fx:value="Confirmada" />
                           <String fx:value="Atendida" />
                           <String fx:value="Cancelada" />
                        </FXCollections>
                     </items>
                  </ComboBox>
               </children>
            </HBox>

            <TableView fx:id="tblCitas" minHeight="220.0" VBox.vgrow="ALWAYS">
               <columns>
                  <TableColumn prefWidth="70.0" text="Hora" />
                  <TableColumn prefWidth="140.0" text="Cliente" />
                  <TableColumn prefWidth="130.0" text="Empresa" />
                  <TableColumn prefWidth="110.0" text="Servicio" />
                  <TableColumn prefWidth="110.0" text="Atiende" />
                  <TableColumn prefWidth="100.0" styleClass="col-estado" text="Estado" />
               </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label fx:id="lblResumen" styleClass="texto-tenue" text="5 citas  ·  3 confirmadas  ·  1 cancelada" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="btnCancelarCita" mnemonicParsing="false" onAction="#cancelarCita" styleClass="boton-peligro" text="Cancelar cita" />
                  <Button fx:id="btnReprogramar" mnemonicParsing="false" onAction="#reprogramar" styleClass="boton-secundario" text="Reprogramar" />
                  <Button fx:id="btnAtendida" mnemonicParsing="false" onAction="#marcarAtendida" styleClass="boton-primario" text="Marcar atendida" />
               </children>
            </HBox>
         </children>
      </VBox>

      <!-- ===================== NUEVA CITA ===================== -->
      <VBox minWidth="350.0" prefWidth="370.0" spacing="10.0" styleClass="tarjeta">
         <children>
            <Label styleClass="tarjeta-titulo" text="Agendar nueva cita" />
            <Label styleClass="tarjeta-subtitulo" text="Registra la atención para darle seguimiento" />

            <Label styleClass="seccion-titulo" text="DATOS DEL CLIENTE" />
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Cliente" />
                  <HBox spacing="8.0">
                     <children>
                        <ComboBox fx:id="cmbCliente" editable="true" maxWidth="1.7976931348623157E308" promptText="Buscar o escribir nombre" HBox.hgrow="ALWAYS" />
                        <Button fx:id="btnNuevoCliente" mnemonicParsing="false" onAction="#nuevoCliente" styleClass="boton-secundario">
                           <graphic>
                              <SVGPath content="M12 5 V19 M5 12 H19" styleClass="icono-boton" />
                           </graphic>
                           <tooltip>
                              <Tooltip text="Registrar cliente nuevo" />
                           </tooltip>
                        </Button>
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Empresa" />
                  <TextField fx:id="txtEmpresa" promptText="Nombre de la empresa" />
               </children>
            </VBox>
            <HBox spacing="10.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Teléfono" />
                        <TextField fx:id="txtTelefono" promptText="33 1234 5678" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Correo" />
                        <TextField fx:id="txtCorreo" promptText="correo@empresa.com" />
                     </children>
                  </VBox>
               </children>
            </HBox>

            <Separator styleClass="separador">
               <VBox.margin>
                  <Insets top="4.0" />
               </VBox.margin>
            </Separator>
            <Label styleClass="seccion-titulo" text="DATOS DE LA CITA" />
            <HBox spacing="10.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Fecha" />
                        <DatePicker fx:id="dpFechaCita" maxWidth="1.7976931348623157E308" promptText="dd/mm/aaaa" />
                     </children>
                  </VBox>
                  <VBox prefWidth="120.0" spacing="5.0">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Hora" />
                        <ComboBox fx:id="cmbHora" maxWidth="1.7976931348623157E308" promptText="--:--" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Tipo de servicio" />
                        <ComboBox fx:id="cmbServicio" maxWidth="1.7976931348623157E308" promptText="Seleccionar">
                           <items>
                              <FXCollections fx:factory="observableArrayList">
                                 <String fx:value="Asesoría" />
                                 <String fx:value="Levantamiento" />
                                 <String fx:value="Instalación" />
                                 <String fx:value="Mantenimiento" />
                                 <String fx:value="Seguimiento" />
                              </FXCollections>
                           </items>
                        </ComboBox>
                     </children>
                  </VBox>
                  <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                     <children>
                        <Label styleClass="etiqueta-campo" text="Atiende" />
                        <ComboBox fx:id="cmbAtiende" maxWidth="1.7976931348623157E308" promptText="Asesor" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="etiqueta-campo" text="Dirección de la visita" />
                  <TextField fx:id="txtDireccion" promptText="Calle, número, colonia, ciudad" />
               </children>
            </VBox>
            <VBox spacing="5.0" VBox.vgrow="ALWAYS">
               <children>
                  <Label styleClass="etiqueta-campo" text="Necesidades del cliente y posibles soluciones" />
                  <TextArea fx:id="txtNecesidades" minHeight="70.0" prefRowCount="3" promptText="Describe qué necesita el cliente..." wrapText="true" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>

            <HBox spacing="10.0">
               <VBox.margin>
                  <Insets top="4.0" />
               </VBox.margin>
               <children>
                  <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiar" styleClass="boton-secundario" text="Limpiar" />
                  <Button fx:id="btnGuardarCita" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#guardarCita" styleClass="boton-exito" text="Guardar cita" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</HBox>
